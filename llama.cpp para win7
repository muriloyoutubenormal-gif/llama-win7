name: llama.cpp para Win7 (32 bits, sem AVX)

on:
  workflow_dispatch:
    inputs:
      ref:
        description: "Tag ou branch do llama.cpp (ex: master ou b4000)"
        required: true
        default: "master"

jobs:
  build:
    runs-on: windows-latest
    defaults:
      run:
        shell: msys2 {0}
    steps:
      - uses: msys2/setup-msys2@v2
        with:
          msystem: MINGW32
          update: true
          install: >-
            git
            mingw-w64-i686-gcc
            mingw-w64-i686-cmake
            mingw-w64-i686-ninja

      - name: Clonar llama.cpp
        run: git clone --depth 1 --branch "${{ inputs.ref }}" https://github.com/ggml-org/llama.cpp src

      - name: Configurar
        run: |
          cd src
          cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
            -DGGML_NATIVE=OFF -DGGML_AVX=OFF -DGGML_AVX2=OFF -DGGML_AVX512=OFF \
            -DGGML_FMA=OFF -DGGML_F16C=OFF -DGGML_BMI2=OFF -DGGML_SSE42=OFF \
            -DGGML_OPENMP=OFF -DGGML_WIN_VER=0x601 \
            -DLLAMA_CURL=OFF -DBUILD_SHARED_LIBS=OFF \
            -DCMAKE_C_FLAGS="-mssse3" -DCMAKE_CXX_FLAGS="-mssse3" \
            -DCMAKE_EXE_LINKER_FLAGS="-static"

      - name: Compilar
        run: |
          cd src
          cmake --build build -j4 --target llama-cli llama-bench
          ls -la build/bin

      - uses: actions/upload-artifact@v4
        with:
          name: llama-win7-x86
          path: src/build/bin/*.exe
          if-no-files-found: error
